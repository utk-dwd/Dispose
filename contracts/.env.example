# Environment variables for deployment
# Add your private key here for deployment (DO NOT commit this file)
# PRIVATE_KEY=0x...
# Deployment Environment Variables
# 🔥 IMPORTANT: Copy this to .env and fill in your REAL values
# 🔒 NEVER commit the actual .env file with real keys!

# Your deployer private key (needs ETH on Base mainnet for gas)
# Get this from your wallet (MetaMask -> Account Details -> Export Private Key)
PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Base mainnet RPC (you can use the public one or get from Alchemy/Infura)
BASE_RPC_URL=https://mainnet.base.org

# For contract verification on BaseScan (get free API key from basescan.org)
BASESCAN_API_KEY=YourBaseScanApiKeyHere

# Pimlico API key (get free account from https://pimlico.io)
PIMLICO_API_KEY=pim_YourPimlicoApiKeyHere

# Amount of ETH needed for deployment: ~0.001 ETH (very small amount)
# Make sure your wallet has at least 0.01 ETH on Base mainnet
# ETHERSCAN_API_KEY=...

# For local testing
ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80